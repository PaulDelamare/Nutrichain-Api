generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String            @id @unique @default(uuid())
  email              String            @unique
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  name               String
  emailVerified      Boolean           @default(false)
  image              String?
  twoFactorEnabled   Boolean?          @default(false)
  sessions           Session[]
  accounts           Account[]
  members            Member[]
  invitations        Invitation[]
  twofactors         TwoFactor[]
  lots               Batch[]
  transformations    Transformation[]
  tests_qualite      QualityControl[]
  receptions         Receipt[]
  expeditions        Shipment[]
  mouvements         Batch_Mouvement[]
  idempotencyKeys    IdempotencyKey[]
  platformAdmin      PlatformAdmin?
  rebuts             ScrapRecord[]
  unites_logistiques Logistic_Unit[]

  @@map("user")
}

// Administrateur de la PLATEFORME (personnel NutriChain), au-dessus des organisations.
// Il crée et gère les organisations clientes ; il n'est JAMAIS Member d'une organisation et
// n'accède PAS à leurs données métier — l'isolation repose sur l'absence d'organisation active.
model PlatformAdmin {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("platform_admin")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

/// Compteur d'échecs de connexion, par compte visé.
///
/// Un limiteur par IP ne protège pas un compte CIBLÉ : un attaquant qui dispose de plusieurs
/// adresses le contourne sans effort. Le verrouillage porte donc aussi sur le compte lui-même.
///
/// L'e-mail n'est jamais stocké en clair : on garde une empreinte HMAC-SHA-256 calculée avec le
/// secret du serveur. Un condensat nu serait forçable au dictionnaire — l'espace des adresses
/// d'une entreprise s'énumère en quelques secondes. Cela reste une donnée PSEUDONYMISÉE, donc une
/// donnée personnelle : c'est le job de purge quotidien qui la borne dans le temps.
model LoginAttempt {
  /// HMAC-SHA-256 de l'e-mail normalisé (minuscules, sans espaces).
  email_hash      String    @id
  /// Échecs consécutifs depuis `first_failed_at`. Remis à zéro par une connexion réussie.
  failed_count    Int       @default(0)
  first_failed_at DateTime  @default(now())
  /// Tant que cette date est future, toute tentative est refusée, mot de passe correct compris.
  locked_until    DateTime?
  updated_at      DateTime  @updatedAt

  @@index([locked_until])
  @@map("login_attempt")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id                 String            @id
  name               String
  slug               String
  logo               String?
  createdAt          DateTime
  metadata           String?
  gs1_company_prefix String?
  members            Member[]
  invitations        Invitation[]
  Batch              Batch[]
  Receipt            Receipt[]
  Supplier           Supplier[]
  Product            Product[]
  Location           Location[]
  Equipment          Equipment[]
  Audit_Log          Audit_Log[]
  Audit_Checkpoint   Audit_Checkpoint?
  Alert              Alert[]
  QualityControl     QualityControl[]
  Customer           Customer[]
  Shipment           Shipment[]
  IdempotencyKey     IdempotencyKey[]
  EPCIS_Event        EPCIS_Event[]
  IotGateway         IotGateway[]
  ScrapRecord        ScrapRecord[]
  Logistic_Unit      Logistic_Unit[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  // Un utilisateur appartient à UNE seule organisation (décision produit). Rend déterministe le
  // choix de l'org active à la connexion (le hook prenait `findFirst` sans ordre) et empêche
  // qu'accepter une invitation vers une 2e org crée un membre fantôme.
  @@unique([userId])
  @@index([organizationId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model TwoFactor {
  id          String   @id
  secret      String
  backupCodes String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified    Boolean? @default(true)

  // Verrouillage de la VERIFICATION du second facteur, introduit par Better-Auth 1.6.25 et écrit
  // par sa table : sans ces deux colonnes, l'enrôlement 2FA échoue en 500 dès la montée de version
  // (« Unknown argument `failedVerificationCount` »). Le complément logique du verrou par compte
  // qui protège déjà le mot de passe : le second facteur, lui, n'était pas freiné.
  // NON NULLABLE à dessein. Better-Auth incrémente ce compteur (`increment: 1`) et relit le
  // résultat avec `?? 0` pour décider du verrouillage. Or `NULL + 1` vaut `NULL` en SQL : une
  // seule ligne à `NULL` désactiverait le verrou pour cet utilisateur, définitivement et sans
  // bruit. La bibliothèque n'écrit jamais `NULL` ici — seulement `0` ou un incrément — donc rien
  // ne justifie de laisser cette porte ouverte.
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

// --- UTILITAIRES ---
model Unit {
  code           String  @id
  nom            String
  factor_to_base Decimal
  lot            Batch[]
}

model EPCIS_Event {
  id              String       @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  event_time      DateTime
  event_type      String
  related_entity  String
  related_id      String
  payload         Json

  @@index([organization_id])
  @@index([related_entity, related_id])
  @@index([event_time])
}

// --- LIEUX ET MATERIEL ---
model Location {
  id              String       @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  nom             String
  type            String
  description     String?
  // Position réelle du lieu, saisie par l'organisation — jamais déduite du nom (cf. #23 : le front
  // devinait « Loire » → Nantes et affichait ce point comme une donnée de la base).
  // Nullable et indissociables : un lieu sans coordonnées est légitime, la fiche lot n'affiche alors
  // pas de carte. DECIMAL(9,6) = ~11 cm de résolution, la précision d'un plan d'usine.
  latitude        Decimal?     @db.Decimal(9, 6)
  longitude       Decimal?     @db.Decimal(9, 6)
  // Désactivation douce : un lieu référencé par du matériel ne peut pas être supprimé (FK Restrict).
  // Archivé, il disparaît des listes de sélection mais reste lisible sur l'historique existant.
  is_active       Boolean      @default(true)
  materiel        Equipment[]

  @@index([organization_id])
}

model Equipment {
  id              String           @id @default(uuid())
  organization_id String
  organization    Organization     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  nom             String
  type            String
  id_lieu         String
  lieu            Location         @relation(fields: [id_lieu], references: [id])
  statut          String           @default("PRET")
  temp_actuelle   Decimal?
  temp_seuil_max  Decimal?
  // Étiquette scannable, posée à la création (jamais sur un GET — cf. #99). NOT NULL : un matériel
  // sans étiquette est un matériel qu'aucun opérateur ne peut désigner.
  qr_code_id      String
  sensor_id       String? // Identifiant du capteur IoT lié (mapping vers TelemetryModel.metadata.sensor_id)
  last_cleaned_at DateTime?
  lots            Batch[]
  transformations Transformation[]

  @@unique([organization_id, sensor_id]) // composite : permet à 2 orgs d'utiliser le même sensor_id sans collision, empêche enumeration cross-tenant
  @@index([organization_id])
}

/// Passerelle IoT : le porteur d'une clé capteur, rattaché à SON organisation.
///
/// Avant, `machineAuth` retombait sur `API_KEY_ORG_ID` — une variable d'environnement UNIQUE :
/// toute trame, quelle que soit sa provenance, était estampillée de l'organisation du `.env`.
/// Une organisation créée après coup n'avait donc aucune chaîne du froid (ingest 202, zéro alerte),
/// et un `sensor_id` homonyme mettait en quarantaine les lots d'une AUTRE organisation.
/// La clé porte désormais son tenant en base ; elle est stockée hachée (SHA-256) et révocable.
model IotGateway {
  id              String       @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  nom             String
  key_hash        String       @unique
  revoked_at      DateTime?
  created_at      DateTime     @default(now())

  @@index([organization_id])
}

// --- REFERENTIEL CATALOGUE ---
model Product {
  id                        String           @id @default(uuid())
  organization_id           String
  organization              Organization     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  nom                       String
  code_gtin                 String
  categorie                 String
  duree_conservation_defaut Int
  seuil_alerte_stock        Decimal
  unite_reference           String
  // Désactivation douce : un produit référencé par des lots/transformations ne peut être supprimé
  // (FK Restrict). Archivé, il disparaît des sélections et n'accepte plus ni réception ni production.
  is_active                 Boolean          @default(true)
  lots                      Batch[]
  transformations           Transformation[]

  /// Le GTIN identifie le produit (URN GS1) et sert de clé d'idempotence à l'import CSV.
  /// La contrainte est en BASE, pas seulement applicative : vérifié côté application, deux
  /// créations simultanées passaient toutes les deux et le catalogue se retrouvait avec deux
  /// produits pour un même GTIN — après quoi l'import n'en met à jour qu'un, arbitrairement.
  @@unique([organization_id, code_gtin])
  @@index([organization_id])
}

// --- TRACKING LOTS & TRANSFORMATION ---
model Batch {
  id                   String       @id @default(uuid())
  organization_id      String
  organization         Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  /// Numéro de lot court GS1 (AI 10, max 20 caractères) — porté par les URN LGTIN et le Digital Link.
  lot_number           String
  id_produit           String
  produit              Product      @relation(fields: [id_produit], references: [id])
  quantite_actuelle    Decimal
  unite_code           String
  unite                Unit         @relation(fields: [unite_code], references: [code])
  quantite_base        Decimal
  date_peremption      DateTime?
  statut               String       @default("EN_STOCK")
  // Statut d'avant la mise en quarantaine FROID, pour y revenir à la levée plutôt que de forcer
  // EN_STOCK : un produit fini qui attendait son contrôle de sortie (EN_ATTENTE_QC) doit y
  // retourner, jamais devenir expédiable au seul motif que l'incident frigo est résolu.
  // Non-null uniquement tant que statut = BLOQUE ; remis à null à la levée ou au rappel.
  statut_avant_blocage String?
  id_materiel_actuel   String?
  materiel             Equipment?   @relation(fields: [id_materiel_actuel], references: [id])
  // Réception d'origine (matière première). Nul pour un produit fini issu de transformation.
  // Restrict : une réception qui a produit des lots ne doit pas pouvoir être supprimée en effaçant
  // le lien amont en silence — la traçabilité vers la ferme resterait alors introuvable.
  id_receipt           String?
  receipt              Receipt?     @relation(fields: [id_receipt], references: [id], onDelete: Restrict)
  date_creation        DateTime     @default(now())
  created_by           String
  user                 User         @relation(fields: [created_by], references: [id])
  version              Int          @default(1)

  transformations_enfants Transformation[]            @relation("TransformationEnfant")
  transformations_parents TransformationComposition[]
  tests_qualite           QualityControl[]
  liaisons                Liaison_Shipment[]
  mouvements              Batch_Mouvement[]
  rebut                   ScrapRecord?
  contenus_palette        Logistic_Unit_Content[]

  @@unique([organization_id, lot_number])
  @@index([organization_id])
}

/// Destruction tracée d'un lot sans autre issue (rappel ALERTE ou quarantaine BLOQUE non levable).
/// Sans ce modèle, la quantité d'un lot rappelé reste indéfiniment aux livres, sans aucune preuve
/// de destruction opposable en cas de contrôle sanitaire.
model ScrapRecord {
  id              String       @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  id_lot          String       @unique
  lot             Batch        @relation(fields: [id_lot], references: [id], onDelete: Restrict)
  quantite        Decimal
  unite           String
  motif           String
  id_user         String
  user            User         @relation(fields: [id_user], references: [id])
  created_at      DateTime     @default(now())

  @@index([organization_id])
}

model Transformation {
  id               String    @id @default(uuid())
  id_lot_enfant    String
  lot_enfant       Batch     @relation("TransformationEnfant", fields: [id_lot_enfant], references: [id])
  id_produit_fini  String
  produit          Product   @relation(fields: [id_produit_fini], references: [id])
  id_user          String
  user             User      @relation(fields: [id_user], references: [id])
  id_materiel      String
  materiel         Equipment @relation(fields: [id_materiel], references: [id])
  statut           String    @default("EN_COURS")
  note_technique   Json?
  horodatage_debut DateTime  @default(now())
  horodatage_fin   DateTime?
  duration_seconds Int?

  compositions TransformationComposition[]
  mouvements   Batch_Mouvement[]

  @@index([id_lot_enfant])
}

model TransformationComposition {
  id_transformation String
  transformation    Transformation @relation(fields: [id_transformation], references: [id])
  id_lot_parent     String
  lot_parent        Batch          @relation(fields: [id_lot_parent], references: [id])
  quantite_prelevee Decimal
  unite             String
  lot_parent_epuise Boolean
  note              String?

  @@id([id_transformation, id_lot_parent])
  @@index([id_lot_parent])
}

// --- ALERTE & AUDIT WORM ---
model Alert {
  id              String       @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  type            String
  niveau_gravite  String
  message         String
  /// Pic de température de l'excursion (°C) — renseigné pour les alertes TEMP_EXCURSION. Donnée
  /// sanitaire structurée : le mobile l'affiche sans avoir à parser le `message`.
  peak_temp       Decimal?
  /// Seuil max dépassé au moment de la détection (°C).
  temp_seuil      Decimal?
  id_materiel     String?
  related_entity  String?
  related_id      String?
  statut          String       @default("ACTIVE")
  created_at      DateTime     @default(now())
  resolved_by     String?
  resolved_at     DateTime?

  @@index([organization_id])
}

model Audit_Log {
  id              Int          @id @default(autoincrement())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  id_user         String?
  action          String
  entity          String
  entity_id       String
  ancienne_valeur Json?
  nouvelle_valeur Json?
  prev_hash       String       @db.Char(64)
  signature_hash  String       @db.Char(64)
  horodatage      DateTime     @default(now())

  // Filet d'intégrité WORM : deux lignes d'une même organisation ne peuvent pas chaîner sur le
  // même prev_hash (fork). Postgres n'a pas de gap lock ; ce sont cet index unique + le retry
  // sur conflit (withWriteConflictRetry) qui garantissent une chaîne linéaire sous concurrence.
  @@unique([organization_id, prev_hash])
  @@index([organization_id])
  @@index([id_user])
  @@index([entity, entity_id])
  @@index([horodatage])
  @@index([action])
  @@index([signature_hash])
}

// --- INTEGRITE AUDIT (PCA/PRA) ---
// High-water mark per-org : permet de détecter une troncature silencieuse
// de la fin de la hash chain (rows supprimés post-restore ou tampering).
// Le cron `auditChainVerify` upsert cette ligne après chaque verify OK.
model Audit_Checkpoint {
  organization_id     String       @id
  organization        Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  last_id             Int
  last_signature_hash String       @db.Char(64)
  last_row_count      Int
  verified_at         DateTime     @default(now())
}

// --- CONTROLE QUALITE ---

model QualityControl {
  id              String       @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  id_lot          String
  lot             Batch        @relation(fields: [id_lot], references: [id])
  type_test       String
  resultat        String
  id_user_labo    String
  user            User         @relation(fields: [id_user_labo], references: [id])
  certificat_pdf  String?
  date_test       DateTime
  notes           String?

  @@index([organization_id])
}

// --- RECEPTION & FOURNISSEUR ---
model Supplier {
  id              String       @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  nom_ferme       String
  type_produit    String?
  contact_qualite String?
  adresse_siege   String
  // Désactivation douce : un fournisseur référencé par des réceptions ne peut pas être supprimé.
  is_active       Boolean      @default(true)
  receptions      Receipt[]

  @@index([organization_id])
}

model Receipt {
  id                         String       @id @default(uuid())
  organization_id            String
  organization               Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  id_fournisseur             String
  fournisseur                Supplier     @relation(fields: [id_fournisseur], references: [id])
  shipment_id                String
  date_reception             DateTime
  temperature_camion_summary Json?
  temperature_camion_raw     Json?
  statut_controle            String
  received_by                String
  user                       User         @relation(fields: [received_by], references: [id])
  lots                       Batch[]

  @@unique([organization_id, shipment_id])
  @@index([organization_id])
}

// --- EXPEDITION & CLIENT ---
model Customer {
  id                String       @id @default(uuid())
  organization_id   String
  organization      Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  nom_enseigne      String
  contact_urgence   String?
  email             String?
  adresse_livraison String
  notes             String?
  external_ref      String? // identifiant du client dans l'ERP source (clé d'idempotence d'import)
  // Désactivation douce : un client référencé par des expéditions ne peut être supprimé.
  is_active         Boolean      @default(true)
  expeditions       Shipment[]

  @@unique([organization_id, external_ref])
  @@index([organization_id])
}

model Shipment {
  id                  String       @id @default(uuid())
  organization_id     String
  organization        Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  id_client           String
  client              Customer     @relation(fields: [id_client], references: [id])
  shipment_id         String
  date_envoi          DateTime
  transporteur        String
  destination_adresse String?
  statut_livraison    String
  created_by          String
  user                User         @relation(fields: [created_by], references: [id])

  liaisons   Liaison_Shipment[]
  mouvements Batch_Mouvement[]

  @@unique([organization_id, shipment_id])
  @@index([organization_id])
}

model Liaison_Shipment {
  id                  String         @id @default(uuid())
  id_expedition       String
  expedition          Shipment       @relation(fields: [id_expedition], references: [id])
  id_lot              String
  lot                 Batch          @relation(fields: [id_lot], references: [id])
  quantite_expediee   Decimal
  unite               String
  // Palette sur laquelle ce lot a voyagé. Remplace `pallet_id`, déclaré à l'origine et jamais
  // écrit : l'intention était juste, il n'existait aucune entité à référencer.
  // Nullable — une expédition antérieure au modèle de palette n'en a aucune.
  // ⚠️ `id_lot` reste porté ici : le rappel produit interroge `id_lot IN (...)` avec son double
  // filtre de cloisonnement. Le remplacer par la seule palette ferait échouer un rappel en
  // silence, sans erreur et avec zéro expédition impactée.
  id_unite_logistique String?
  unite_logistique    Logistic_Unit? @relation(fields: [id_unite_logistique], references: [id], onDelete: Restrict)

  // Le rappel produit interroge cette table par `id_lot IN (...)` (recall.service.ts) : sans
  // index, chaque rappel fait un seq scan. `id_expedition` couvre la jointure vers Shipment.
  @@index([id_lot])
  @@index([id_expedition])
  @@index([id_unite_logistique])
}

/// Unité logistique GS1 — la palette, le contenant qu'on manipule physiquement.
///
/// Le SSCC identifie CE contenant-ci, et il lui est attribué à la **palettisation**, pas au départ
/// du camion : une palette existe avant d'être expédiée (elle attend sur un quai), et elle survit à
/// la réception (le destinataire la range telle quelle). Avant ce modèle, le SSCC était écrit dans
/// `Shipment.shipment_id` — un même champ portait la référence commerciale du bon de livraison et
/// l'identifiant GS1 d'un contenant physique, si bien que douze palettes d'un même camion
/// partageaient un seul numéro.
///
/// Elle ne porte NI statut NI position. La position reste sur le lot (`Batch.id_materiel_actuel`),
/// parce que c'est exactement ce que filtre la mise en quarantaine froid : déplacer la source de
/// vérité ici ferait bloquer zéro lot à la prochaine excursion, sans aucun bruit. Ranger une
/// palette met donc à jour la position de ses lots ; sa position, elle, se déduit d'eux.
model Logistic_Unit {
  id              String       @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  /// 18 chiffres, clé de contrôle GS1 comprise.
  sscc            String
  /// `INTERNE` (palette que nous avons montée) ou `FOURNISSEUR` (SSCC lu sur une palette reçue).
  /// Distinction nécessaire : nous garantissons l'unicité des nôtres, pas celle des leurs.
  source          String       @default("INTERNE")
  created_at      DateTime     @default(now())
  created_by      String
  user            User         @relation(fields: [created_by], references: [id])

  contenu  Logistic_Unit_Content[]
  liaisons Liaison_Shipment[]

  // Un SSCC ne se réutilise pas : deux palettes d'une même organisation ne peuvent pas le partager.
  // La contrainte est en base et pas seulement applicative — deux palettisations simultanées
  // passaient toutes les deux la vérification applicative et fabriquaient le doublon.
  @@unique([organization_id, sscc])
  @@index([organization_id])
}

/// Contenu d'une palette : quel lot, en quelle quantité.
///
/// La quantité est portée ici parce qu'un lot se répartit sur plusieurs palettes — 800 kg de beurre
/// tiennent rarement sur une seule. Constituer une palette ne DÉDUIT PAS le stock : la déduction
/// reste à l'expédition, là où vit le verrou optimiste. Conséquence assumée : rien n'empêche de
/// monter deux palettes sur le même stock la veille, l'incohérence se découvre au départ.
model Logistic_Unit_Content {
  id_unite_logistique String
  unite_logistique    Logistic_Unit @relation(fields: [id_unite_logistique], references: [id], onDelete: Cascade)
  id_lot              String
  lot                 Batch         @relation(fields: [id_lot], references: [id], onDelete: Restrict)
  quantite            Decimal
  /// Unité de mesure du lot, dénormalisée comme dans `Liaison_Shipment`.
  unite               String

  @@id([id_unite_logistique, id_lot])
  @@index([id_lot])
}

// --- MOUVEMENTS (APPEND ONLY) ---
model Batch_Mouvement {
  id                Int             @id @default(autoincrement())
  id_lot            String
  lot               Batch           @relation(fields: [id_lot], references: [id])
  type_action       String
  quantite          Decimal
  unite             String
  id_transformation String?
  transformation    Transformation? @relation(fields: [id_transformation], references: [id])
  id_expedition     String?
  expedition        Shipment?       @relation(fields: [id_expedition], references: [id])
  id_user           String?
  user              User?           @relation(fields: [id_user], references: [id])
  created_at        DateTime        @default(now())
  metadata          Json?

  // L'historique d'un lot se lit toujours PAR lot et dans l'ordre chronologique.
  // Sans cet index, la fiche lot fait un seq scan sur une table append-only.
  @@index([id_lot, created_at])
}

// --- SYNC MOBILE OFFLINE-FIRST ---
// Stocke les clés d'idempotency pour POST /api/sync/scans.
// Permet aux clients (React Native offline) de rejouer un bulk sans créer de doublons.
// TTL ~7j géré par cleanupIdempotencyKeys.job.
model IdempotencyKey {
  id               String       @id @default(uuid())
  organization_id  String
  organization     Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  client_op_id     String
  user_id          String
  user             User         @relation(fields: [user_id], references: [id])
  request_hash     String       @db.Char(64) // SHA256 hex du payload normalisé
  response_status  String // 'pending' (placeholder pendant l'exécution) → 'ok' (finalisée). Les conflits/erreurs ne persistent pas (rollback de la transaction atomique).
  response_payload Json
  created_at       DateTime     @default(now())
  expires_at       DateTime

  @@unique([organization_id, client_op_id])
  @@index([organization_id])
  @@index([expires_at])
}
