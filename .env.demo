# Secrets de DÉMONSTRATION — publiés volontairement dans ce dépôt.
#
# Ce fichier existe pour que la pile locale démarre en une commande sans que des secrets connus
# soient un défaut invisible (#248) :
#
#     docker compose --env-file .env.demo up --build
#
# Les valeurs ci-dessous n'en sont pas : elles sont lisibles par quiconque a ouvert ce dépôt.
# `ALLOW_DEMO_SECRETS=1` le déclare explicitement, et l'API refuse de démarrer avec ces valeurs
# tant que ce drapeau n'est pas posé. C'est la différence avec l'état précédent, où la pile
# démarrait avec ces mêmes secrets sans rien annoncer.
#
# ⚠️ Ne jamais utiliser ce fichier ailleurs qu'en local. Pour un déploiement réel, générer :
#     openssl rand -base64 32
# ou :
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

ALLOW_DEMO_SECRETS=1

# Signe les cookies de session et les jetons Better-Auth.
BETTER_AUTH_SECRET=secret-de-demo-docker-32-caracteres-minimum
# Identifie l'application appelante (mobile, front). Publique par nature : compilée dans le bundle.
API_KEY=cle-api-de-demo-docker-a-remplacer-en-production
# Authentifie les capteurs. VRAI secret : une trame met des lots en quarantaine et lève une alerte.
IOT_API_KEY=cle-capteurs-de-demo-docker-a-remplacer-en-production
